# Application
APP_NAME=Vision Surveillance
APP_ENV=development

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_FILE=app.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5

# Camera / RTSP (CPU-only Windows setup)
CAMERA_IP=192.168.1.100
CAMERA_PORT=554
CAMERA_USER=admin
CAMERA_PASS=change_me
CAMERA_MAIN_STREAM=stream1
CAMERA_SUB_STREAM=stream2
# Optional camera source override: webcam, url, file, rtsp
CAMERA_SOURCE=webcam
WEBCAM_INDEX=0
WEBCAM_BACKEND=dshow
WEBCAM_WIDTH=1280
WEBCAM_HEIGHT=720
WEBCAM_FPS=30

# RTSP reliability settings
RTSP_RECONNECT_INITIAL_DELAY=1.0
RTSP_RECONNECT_MAX_DELAY=30.0
RTSP_STALE_TIMEOUT=5.0

# Person detection (YOLO nano + OpenVINO CPU optimization)
DETECTION_MODEL=models/yolo11n.pt
DETECTION_CONFIDENCE=0.45
DETECTION_IMGSZ=640
DETECTION_TARGET_FPS=4.0
DETECTION_FRAME_SKIP=0
DETECTION_USE_OPENVINO=true

# Motion gate (MOG2 background subtraction)
MOTION_GATE_ENABLED=true
MOTION_THRESHOLD=0.005
MOTION_VAR_THRESHOLD=25.0
MOTION_HISTORY=300
MOTION_DOWNSCALE_WIDTH=320
MOTION_HOLD_SECONDS=0.5
MOTION_WARMUP_FRAMES=2

# Storage, snapshots & retention
DB_PATH=surveillance.db
SNAPSHOTS_DIR=snapshots
SNAPSHOT_MAX_WIDTH=480
SNAPSHOT_QUALITY=80
EVENT_TRACK_COOLDOWN_SECONDS=60.0
EVENT_ZONE_COOLDOWN_SECONDS=60.0
EVENT_ABSENCE_RESET_SECONDS=5.0
RETENTION_DAYS=30
RETENTION_RUN_HOUR=2
RETENTION_RUN_MINUTE=0

# Local face recognition (OpenCV YuNet + SFace, never uploaded)
FACE_YUNET_MODEL=models/face_detection_yunet_2023mar.onnx
FACE_SFACE_MODEL=models/face_recognition_sface_2021dec.onnx
FACES_DATA_DIR=faces_data
FACE_MATCH_THRESHOLD=0.40
FACE_MIN_SIZE_PX=80
FACE_BLUR_MIN_LAPLACIAN=60.0
FACE_MIN_PERSON_CROP_WIDTH=80
FACE_MIN_PERSON_CROP_HEIGHT=120
FACE_MAX_FRAMES_PER_TRACK=5
FACE_VOTE_MIN_SAMPLES=2

# Telegram notifications & alert rules (never hardcode secrets)
CAMERA_NAME=Front Camera
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_ON_UNKNOWN_PERSON=true
ALERT_ON_KNOWN_PERSON=false
ALERT_ON_ZONE_INTRUSION=true
ALERT_ON_CAMERA_OFFLINE=true
ALERT_ON_CAMERA_ONLINE=true
ALERT_ON_SYSTEM_ERROR=true
TELEGRAM_POLL_INTERVAL=2.0
TELEGRAM_BACKOFF_INITIAL=2.0
TELEGRAM_BACKOFF_MAX=60.0
TELEGRAM_RATE_LIMIT_PER_MIN=20
TELEGRAM_MIN_INTERVAL_SECONDS=0.5

# Local-first Backend API & Auth (never hardcode secrets)
API_HOST=127.0.0.1
API_PORT=8000
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
API_RATE_LIMIT_MAX_REQUESTS=120
API_WRITE_RATE_LIMIT_MAX_REQUESTS=30
API_RATE_LIMIT_WINDOW_SECONDS=60
API_MAX_REQUEST_BYTES=1048576
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
UPLOAD_MAX_BYTES=5242880

# go2rtc WebRTC streaming bridge (runs locally on 127.0.0.1:1984)
# Bind WebRTC media port to localhost by default, or <tailscale-ip>:8555 for mobile Tailscale
GO2RTC_WEBRTC_LISTEN=127.0.0.1:8555
GO2RTC_WEBRTC_CANDIDATE=

# Optional off-site Supabase event & thumbnail mirror (disabled by default; never upload face photos/embeddings)
CLOUD_SYNC=false
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=event-thumbnails
SUPABASE_TABLE=events
CLOUD_SYNC_RETENTION_DAYS=30
CLOUD_SYNC_POLL_INTERVAL=5.0
CLOUD_SYNC_BACKOFF_INITIAL=2.0
CLOUD_SYNC_BACKOFF_MAX=60.0
CLOUD_SYNC_CLEANUP_HOUR=3
CLOUD_SYNC_THUMBNAIL_MAX_WIDTH=320
CLOUD_SYNC_THUMBNAIL_QUALITY=70

# Windows reliability, disk-space guard & weekly backup
ENGINE_FRAME_STALL_SECONDS=30.0
DISK_LOW_WARN_MB=2048
DISK_CRITICAL_STOP_MB=512
DISK_CHECK_INTERVAL_SECONDS=30.0
# Point BACKUP_DIR to an external drive (e.g. E:\VisionBackups)
BACKUP_DIR=backups
BACKUP_KEEP_COUNT=8
